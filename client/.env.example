# Only needed when the client is hosted separately from the API.
#
# Left unset, the app calls /api on its own origin — correct for local
# development (Vite proxies it) and when the API serves the built client.
# Set it to the API's full /api URL when the two live on different hosts.
#
# Vite reads this at BUILD time, so a change needs a rebuild, and whatever
# is set here ends up visible in the shipped bundle. Never put a secret here.
#
# VITE_API_URL=https://inoutportal-mod.onrender.com/api
