# Copy to .env and fill in real values
PORT=5000
NODE_ENV=development

# Local MongoDB:  mongodb://127.0.0.1:27017/inout-portal
# Atlas:          mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/inout-portal
MONGO_URI=mongodb://127.0.0.1:27017/inout-portal

# Change this to a long random string before deploying
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173
